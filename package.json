{
  "name": "cubeos",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "setup": "node tools/dev/local.mjs setup",
    "dev": "node tools/dev/local.mjs dev",
    "stop": "node tools/dev/local.mjs stop",
    "local:setup": "node tools/runtime/index.mjs setup",
    "local:start": "node tools/runtime/index.mjs start",
    "local:status": "node tools/runtime/index.mjs status",
    "local:stop": "node tools/runtime/index.mjs stop",
    "local:doctor": "node tools/runtime/index.mjs doctor",
    "cloud:channel:create": "node tools/cloud/channel.mjs",
    "cloud:enable": "node tools/runtime/index.mjs cloud-enable",
    "cloud:disable": "node tools/runtime/index.mjs cloud-disable",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node --test tools/dev/*.test.mjs tools/runtime/*.test.mjs tools/cloud/*.test.mjs && turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": { "turbo": "2.10.11", "railway": "3.12.0" }
}
