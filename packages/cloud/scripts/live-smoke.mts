import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import {ConvexHttpClient} from 'convex/browser';
import {api} from '../convex/_generated/api.js';
import snapshot from '../../contracts/fixtures/chasqui-v2/backend-snapshot-example-v2.json' with {type:'json'};
const [publishFile,readFilePath]=process.argv.slice(2);
if(!publishFile||!readFilePath)throw Error('Explicit disposable capability file paths required');
const pub=JSON.parse(await readFile(publishFile,'utf8')),read=JSON.parse(await readFile(readFilePath,'utf8'));
assert.equal(pub.channelId,read.channelId);
const client=new ConvexHttpClient(read.convexURL,{logger:false});
const body={replicaVersion:1,channelId:pub.channelId,deviceId:pub.deviceId,revisionId:'9007199254740993',snapshot,freshnessByGroup:{}};
const send=(value:unknown,token=pub.publishToken)=>fetch(pub.endpoint,{method:'POST',headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify(value),signal:AbortSignal.timeout(10000)});
assert.equal((await send(body,read.readToken)).status,403);
assert.equal((await send(body)).status,200);
assert.equal((await send(body)).status,200);
assert.equal((await send({...body,revisionId:'9007199254740992'})).status,409);
const result=await client.query(api.replicas.latest,{channelId:read.channelId,readToken:read.readToken});
assert.equal(result.revisionId,'9007199254740993');assert.equal(result.snapshot.sensors.bme680.temperatureC,24.65);
await assert.rejects(client.query(api.replicas.latest,{channelId:read.channelId,readToken:pub.publishToken}));
console.log('PASS: live Convex HTTP, capability separation, exact int64, duplicates and stale rejection.');
