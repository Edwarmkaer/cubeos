{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubeos.local/schemas/snapshot-v2.json",
  "title": "CubeOS readable Chasqui snapshot v2 (no freshness metadata)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deviceId", "receivedAt", "lastSequence", "deviceTime", "missionState", "health", "sensors", "power", "payload", "radio", "gateway"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "deviceId": { "type": "string", "pattern": "^[A-Z0-9_-]{2,12}$" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "lastSequence": { "$ref": "#/$defs/uint32" },
    "deviceTime": {
      "type": "object", "additionalProperties": false, "required": ["unixUtc", "uptimeMs", "utcValid"],
      "properties": {
        "unixUtc": { "type": "integer", "minimum": 0 },
        "uptimeMs": { "$ref": "#/$defs/uint32" },
        "utcValid": { "type": "boolean" }
      }
    },
    "missionState": { "enum": ["BOOT", "SAFE", "ARMED", "RELEASED", "DESCENT", "LANDED", "ERROR"] },
    "health": {
      "type": "object", "additionalProperties": false, "required": ["flags", "errors"],
      "properties": {
        "flags": { "type": "integer", "minimum": 0, "maximum": 255 },
        "errors": { "type": "array", "uniqueItems": true, "items": { "enum": ["GPS_UNAVAILABLE", "SENSOR_FAILURE", "BATTERY_LOW", "STORAGE_FAILURE", "CAMERA_FAILURE", "RADIO_FAILURE"] } },
        "events": { "type": "array", "uniqueItems": true, "items": { "enum": ["DEPLOYMENT_ARMED", "DEPLOYMENT_TRIGGERED"] } }
      }
    },
    "sensors": {
      "type": "object", "additionalProperties": false,
      "required": ["bme680", "bmp280", "tmp102", "bh1750", "guvaS12sd", "mpu6050", "gps"],
      "properties": {
        "bme680": {
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": {
            "status": { "$ref": "#/$defs/sensorStatus" },
            "temperatureC": { "$ref": "#/$defs/nullableNumber" },
            "relativeHumidityPct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "pressurePa": { "$ref": "#/$defs/nullableNumber" },
            "gasResistanceOhm": { "$ref": "#/$defs/nullableNumber" }
          }
        },
        "bmp280": {
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": {
            "status": { "$ref": "#/$defs/sensorStatus" },
            "temperatureC": { "$ref": "#/$defs/nullableNumber" },
            "pressurePa": { "$ref": "#/$defs/nullableNumber" }
          }
        },
        "tmp102": {
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": { "status": { "$ref": "#/$defs/sensorStatus" }, "temperatureC": { "$ref": "#/$defs/nullableNumber" } }
        },
        "bh1750": {
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": { "status": { "$ref": "#/$defs/sensorStatus" }, "illuminanceLux": { "type": ["number", "null"], "minimum": 0 } }
        },
        "guvaS12sd": {
          "type": "object", "additionalProperties": false, "required": ["status", "uvIndex"],
          "properties": {
            "status": { "enum": ["available_uncalibrated", "unverified", "not_installed", "unavailable"] },
            "adcRaw": { "type": ["integer", "null"], "minimum": 0, "maximum": 4095 },
            "sensorMv": { "type": ["integer", "null"], "minimum": 0, "maximum": 3300 },
            "uvIndex": { "type": "null" }
          }
        },
        "mpu6050": {
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": {
            "status": { "$ref": "#/$defs/sensorStatus" },
            "accelerationG": { "$ref": "#/$defs/nullableVector" },
            "angularRateDps": { "$ref": "#/$defs/nullableVector" }
          }
        },
        "gps": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "latitudeDeg", "longitudeDeg", "altitudeM", "speedMps", "headingDeg", "fix", "satellites"],
          "properties": {
            "status": { "enum": ["available", "unverified", "not_installed", "unavailable"] },
            "latitudeDeg": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
            "longitudeDeg": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
            "altitudeM": { "$ref": "#/$defs/nullableNumber" },
            "speedMps": { "type": ["number", "null"], "minimum": 0 },
            "headingDeg": { "type": ["number", "null"], "minimum": 0, "maximum": 359.99 },
            "fix": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
            "satellites": { "type": ["integer", "null"], "minimum": 0, "maximum": 99 }
          }
        }
      }
    },
    "power": {
      "type": "object", "additionalProperties": false, "required": ["status", "batteryVoltageV", "batteryCurrentA", "batteryPowerW"],
      "properties": {
        "status": { "enum": ["available", "monitor_not_installed", "unverified", "unavailable"] },
        "batteryVoltageV": { "type": ["number", "null"], "minimum": 0, "maximum": 20 },
        "batteryCurrentA": { "type": ["number", "null"], "minimum": -20, "maximum": 20 },
        "batteryPowerW": { "type": ["number", "null"], "minimum": -200, "maximum": 200 }
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false, "required": ["cameraOk", "sdFreeMb", "deploymentState"],
      "properties": {
        "cameraOk": { "type": ["boolean", "null"] },
        "sdFreeMb": { "type": ["integer", "null"], "minimum": 0 },
        "deploymentState": { "enum": ["SAFE", "ARMED", "TRIGGERED", "CONFIRMED", "FAULT", null] }
      }
    },
    "radio": {
      "type": "object", "additionalProperties": false, "required": ["status", "rssiDbm", "snrDb", "frequencyMhz"],
      "properties": {
        "status": { "enum": ["available", "hardware_not_confirmed", "unavailable"] },
        "rssiDbm": { "$ref": "#/$defs/nullableNumber" }, "snrDb": { "$ref": "#/$defs/nullableNumber" },
        "frequencyMhz": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "gateway": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": ["string", "null"], "minLength": 1 } }
    }
  },
  "$defs": {
    "uint32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "nullableNumber": { "type": ["number", "null"] },
    "sensorStatus": { "enum": ["available", "optional_backup", "unverified", "not_installed", "unavailable"] },
    "nullableVector": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": { "x": { "$ref": "#/$defs/nullableNumber" }, "y": { "$ref": "#/$defs/nullableNumber" }, "z": { "$ref": "#/$defs/nullableNumber" } }
    }
  }
}
