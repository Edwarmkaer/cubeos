{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".node-version"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "web#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    }
  }
}
