{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".node-version", ".go-version"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "test": { "dependsOn": ["^test"], "outputs": [] },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@cubeos/api#dev": {
      "cache": false, "persistent": true,
      "env": ["DATABASE_URL", "DEPLOYMENT_MODE", "AUTH_MODE", "LOCAL_CONTAINER", "LISTEN_HOST", "PORT", "ALLOWED_ORIGIN", "PUBLIC_API_HOST", "CLERK_ISSUER", "CLERK_JWKS_URL", "CLERK_AUDIENCE", "CLERK_SECRET_KEY", "INGESTION_ADDRESS", "SERIAL_PORT", "SERIAL_SOURCE_ID", "SERIAL_BAUD"]
    },
    "@cubeos/api#migrate": { "cache": false, "env": ["DATABASE_URL", "DEPLOYMENT_MODE", "AUTH_MODE", "ALLOWED_ORIGIN", "PUBLIC_API_HOST", "CLERK_ISSUER", "CLERK_JWKS_URL", "CLERK_AUDIENCE", "CLERK_SECRET_KEY"] },
    "@cubeos/api#build": { "inputs": ["$TURBO_DEFAULT$"], "outputs": ["dist/**"] },
    "@cubeos/api#test": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "../../packages/contracts/**"],
      "env": ["TEST_DATABASE_URL", "TEST_MIGRATION_DATABASE_URL", "TEST_INGESTION_DATABASE_URL", "TEST_TRANSPORT_DATABASE_URL", "TEST_REALTIME_DATABASE_URL", "TEST_AUTH_DATABASE_URL", "TEST_CONSTRUCTION_DATABASE_URL", "TEST_MEDIA_DATABASE_URL", "TEST_MEDIA_SERVICE_DATABASE_URL", "TEST_S3_ENDPOINT", "TEST_S3_BUCKET", "TEST_S3_ACCESS_KEY", "TEST_S3_SECRET_KEY", "TEST_MEDIA_REQUIRED", "TEST_RECOVERY_DATABASE_URL", "TEST_RAILWAY_DATABASE_URL", "TEST_RAILWAY_PROXY_DATABASE_URL", "RECOVERY_REQUIRED", "CUBEOS_RECOVERY_EVIDENCE_DIR", "TEST_PROJECTION_EVIDENCE_DIR", "TMPDIR", "CI"]
    },
    "web#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "web#dev": { "cache": false, "persistent": true, "env": ["DEPLOYMENT_MODE", "CLERK_PUBLISHABLE_KEY", "NEXT_PUBLIC_*"] }
  }
}
