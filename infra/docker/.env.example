# Generate your own URL-safe local password before running Compose.
POSTGRES_PASSWORD=replace-with-random-local-password
MEDIA_STORAGE=local
MEDIA_MAX_BYTES=67108864
MEDIA_MAX_PIXELS=80000000
# Private bucket provisioned separately; empty while using local storage.
# MEDIA_S3_ENDPOINT=https://your-private-s3-endpoint
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=your-private-bucket
# MEDIA_S3_ACCESS_KEY=configure-locally
# MEDIA_S3_SECRET_KEY=configure-locally
